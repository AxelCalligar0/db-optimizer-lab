# ==============================================================================
# .gitignore - DB Optimizer Lab
# ==============================================================================

# Dependencias de Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Base de datos local generada dinámicamente (~20 MB)
# Debe regenerarse en cada entorno con 'npm run seed'
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
ecommerce.db

# Archivos de entorno y credenciales sensibles
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Archivos del sistema operativo
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# Editores e IDEs (VS Code, JetBrains, etc.)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Archivos temporales, caches y logs
logs/
*.log
tmp/
temp/
.cache/
